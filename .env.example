# Supabase: login y sincronización. Sin estas variables la app funciona igual, solo local.
# En producción los valores públicos vienen de .env.production.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Interruptor de la sincronización. Déjalo en false hasta la Fase 4.
VITE_SYNC_ENABLED=false

# Botón "Continuar con Google" (requiere configurar el proveedor en Supabase).
VITE_GOOGLE_AUTH=false
# Entrar con código al correo (necesita SMTP propio). Apagado en el piloto.
VITE_EMAIL_AUTH=false
